# 阿里云 ECS / 其他 VPS 的部署覆盖项。
#
# 用法：
#   1. cp .env.example .env
#   2. 把本文件里需要的项合并进 .env（不要直接把本文件改名成 .env，它只是一份覆盖示例）
#   3. 填好 OAuth、数据库、备份等其余密钥；本文件只列和这台机器、TURN、通话有关的项
#   4. docker compose -f docker-compose.prod.yml up -d
#
# 2 核 2G、3M 固定带宽的起步配置：并发通话限制在 2 路，避免内存和带宽被同时占满。
# 机器更宽裕时可以调到 3 或更高。

# 网站域名。DNS 要指向这台 ECS；如果走 Cloudflare Tunnel，按 Tunnel 的方式配置。
EIDOLON_DOMAIN=eidolon.shiny-colors-ai.xyz

# ECS 的公网 IPv4（EIP 或分配的公网 IP）。
# TURN/STUN 会用这个地址，不能填经过 Cloudflare 代理的域名。
EIDOLON_PUBLIC_IP=请填写EIP公网IPv4

# ECS 在 VPC 里的内网 IPv4（`ip addr` 查看，通常是 172.x / 10.x）。
# coturn 用它把媒体中继给同机的后端。
EIDOLON_PRIVATE_IP=请填写ECS内网IPv4

# coturn 的共享密钥，生产环境必须填写。生成：
#   openssl rand -hex 32
EIDOLON_TURN_SECRET=请填写随机长字符串

# 安全组需要开放：
#   TCP 3478
#   UDP 3478
#   UDP 49160-49259
EIDOLON_TURN_MIN_PORT=49160
EIDOLON_TURN_MAX_PORT=49259

# 2 核 2G 起步：最多 2 路同时通话；几个人轮流用足够。
EIDOLON_CONCURRENT_CALLS=2
# 单次通话上限（分钟），默认 10；按需要调整。
EIDOLON_CALL_MINUTES=10

# 立绘素材和衣装清单由同一台 Caddy 提供（docker-compose.prod.yml 已挂载
# ./corpus/stand/source/assets 到 /srv/stand-assets）。
# 如果改用 OSS/R2/CDN，把这里换成那个公开地址，并去掉 compose 里的挂载。
EIDOLON_STAND_ASSETS_URL=https://eidolon.shiny-colors-ai.xyz/stand-assets

# 使用自己 fork 的镜像时填写；不填则用上游 GHCR 的镜像。
# 例如：
# EIDOLON_BACKEND_IMAGE=ghcr.io/你的账号/eidolon-sc-backend
# EIDOLON_IMAGE_TAG=main

# 不要在这里填 EIDOLON_ICE_SERVERS 或 EIDOLON_TURN_URLS：
# compose 会按 EIDOLON_PUBLIC_IP 自动生成 TURN/STUN 地址。
# 如果你有自己的外部 TURN，再显式覆盖这两个变量。
