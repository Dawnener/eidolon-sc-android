# 本地开发用的 Caddy：手机访问 http://<局域网 IP>:8080，API 反代到本机后端，静态下载页和立绘由 Caddy 提供。
#
# 1. 后端开发模式只接受 http://localhost|127.0.0.1|::1 的 Origin（sessions.py），
#    手机发来的 Origin 是 http://<局域网 IP>:8080，所以这里改写成 localhost。
#    只改 Origin，Host 保持手机发来的值，Next 的跳转和 metadataBase 才对。
# 2. /apk/ 是下载页，链接指向构建出来的调试包，避免手敲文件名。
{
	admin off
	auto_https off
}

:8080 {
	log {
		output stdout
		format console
	}

	# Cloudflare Tunnel 过来时带着原始协议；HTTP 直接跳 HTTPS，基本认证和会话不能走明文。
	# 局域网直连没有这个头，不受影响。
	@plaintext header X-Forwarded-Proto http
	redir @plaintext https://{host}{uri} 308

	# Cloudflare Access 在边缘校验身份，但静态资源仍可能被边缘缓存；明确 no-store。
	# 立绘路由自己设了可缓存的 Cache-Control，这里只在没有设置时兜底。
	header ?Cache-Control "private, no-store"

	@apkIndex path /apk /apk/
	handle @apkIndex {
		header Content-Type "text/html; charset=utf-8"
		respond <<HTML
<!doctype html>
<html lang="zh-CN">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Eidolon APK</title>
<body style="font: 16px system-ui; background:#11151e; color:#f2f4f8; padding:2rem;">
<h1>Eidolon</h1>
<p><a style="color:#7fb4ff" href="/apk/native/release/Eidolon-SC-0.1.4-release.apk">下载 Eidolon-SC（Release，推荐）</a></p>
<p><a style="color:#7fb4ff" href="/apk/native/debug/Eidolon-SC-0.1.4-debug.apk">下载 Eidolon-SC（Debug）</a></p>
</body>
</html>
HTML
	}

	# 只给真正的安装包加下载头；请求不存在的 .apk 时走普通 404，免得浏览器拿到空的附件
	@apkNative path /apk/native/*/*.apk
	header @apkNative Content-Type "application/vnd.android.package-archive"
	header @apkNative Content-Disposition "attachment"

	handle_path /apk/native/* {
		root * {$EIDOLON_NATIVE_APK_DIR:/nonexistent}
		file_server
	}

	# 通话立绘：原生 App 用官方 spine runtime 直接从这里取衣装文件，
	# 页面来源是 appassets.androidplatform.net，所以需要 CORS。
	# 衣装文件、衣装清单和缩略图在整理目录里分开放，分别映射成存储桶里的三个前缀。
	handle_path /stand-assets/outfits/* {
		root * {$EIDOLON_STAND_LISTS_DIR:/nonexistent}
		file_server
		header Access-Control-Allow-Origin "*"
		header Cache-Control "public, max-age=300"
	}

	handle_path /stand-assets/thumbnails/* {
		root * {$EIDOLON_STAND_THUMBS_DIR:/nonexistent}
		file_server
		header Access-Control-Allow-Origin "*"
		header Cache-Control "public, max-age=300"
	}

	handle_path /stand-assets/call-openers/* {
		root * {$EIDOLON_STAND_CALL_OPENERS_DIR:/nonexistent}
		file_server
		header Access-Control-Allow-Origin "*"
		header Cache-Control "public, max-age=300"
	}

	handle_path /stand-assets/greetings/* {
		root * {$EIDOLON_STAND_GREETINGS_DIR:/nonexistent}
		file_server
		header Access-Control-Allow-Origin "*"
		header Cache-Control "public, max-age=300"
	}

	handle_path /stand-assets/* {
		root * {$EIDOLON_STAND_ASSETS_DIR:/nonexistent}
		file_server
		header Access-Control-Allow-Origin "*"
		header Cache-Control "public, max-age=300"
	}

	# 原生 App 的全部后端接口。
	# 公网请求保留浏览器真实的 Origin，公开部署的后端会校验它；
	# 局域网直连改成 localhost，让没配 EIDOLON_DOMAIN 的本地开发也能用。
	@publicApi {
		host eidolon.shiny-colors-ai.xyz
		path /api/*
	}
	handle @publicApi {
		reverse_proxy 127.0.0.1:8000 {
			header_up Host {hostport}
			header_up X-Forwarded-Proto {scheme}
			flush_interval -1
		}
	}

	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:8000 {
			header_up Host {hostport}
			header_up Origin "http://localhost:3000"
			flush_interval -1
		}
	}

	# 原生 App 的同意页会打开这两个地址
	handle /privacy* {
		rewrite * /privacy.html
		root * {$EIDOLON_WEB_DIR:/nonexistent}
		file_server
	}

	handle /terms* {
		rewrite * /terms.html
		root * {$EIDOLON_WEB_DIR:/nonexistent}
		file_server
	}

	# 只剩下载页、隐私政策和使用条款
	handle {
		root * {$EIDOLON_WEB_DIR:/nonexistent}
		try_files {path} /index.html
		file_server
	}
}
